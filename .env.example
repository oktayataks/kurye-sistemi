# Application
APP_PORT=3000
NODE_ENV=development

# Database (yerel geliştirme için PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=kurye_sistemi

# JWT
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=24h

# Docker compose'da frontend için API URL (build-time)
VITE_API_URL=http://localhost:3000/api/v1
